package com.example.gemindt;

import android.content.Intent;
import android.os.Bundle;
import android.view.View;
import android.widget.AdapterView;
import android.widget.ArrayAdapter;
import android.widget.Button;
import android.widget.CheckBox;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.ListView;
import android.widget.RadioButton;
import android.widget.RadioGroup;
import android.widget.Spinner;
import android.widget.TextView;
import android.widget.Toast;

import androidx.activity.EdgeToEdge;
import androidx.appcompat.app.AppCompatActivity;
import androidx.core.graphics.Insets;
import androidx.core.view.ViewCompat;
import androidx.core.view.WindowInsetsCompat;

import java.util.ArrayList;
import java.util.Random;

public class MainActivity extends AppCompatActivity {

    LinearLayout sekcjakreatora;
    LinearLayout sekcjaQuizzu;
    TextView pytanie;
    EditText editTextPytanie;
    EditText editTextOdpowiedz;
    EditText odpowiedz;
    Button buttonAdd;
    Button zacznijQuizz;
    Button zakoczQuizz;
    Button btnCheckAns;
    ListView listVievFlashcards;
    ArrayList<fiszki> flashcards;
    ArrayList<fiszki> dostepneFlashcardy;
    ArrayAdapter<fiszki> adapter;
    fiszki currentFlashcard;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);


        editTextPytanie = findViewById(R.id.editTextPytanie);
        editTextOdpowiedz = findViewById(R.id.editTextOdpowiedz);
        buttonAdd = findViewById(R.id.buttonAdd);
        listVievFlashcards = findViewById(R.id.listVievFlashcards);
        zacznijQuizz = findViewById(R.id.zacznijQuizz);
        zakoczQuizz = findViewById(R.id.zakoczQuizz);
        btnCheckAns = findViewById(R.id.btnCheckAns);
        sekcjakreatora = findViewById(R.id.sekcjakreatora);
        sekcjaQuizzu = findViewById(R.id.sekcjaQuizzu);
        pytanie = findViewById(R.id.pytanie);
        odpowiedz = findViewById(R.id.odpowiedz);

        flashcards = new ArrayList<>();

        adapter = new ArrayAdapter<>(
                this,
                android.R.layout.simple_list_item_1,
                flashcards
        );

        listVievFlashcards.setAdapter(adapter);

        zacznijQuizz.setOnClickListener(v -> {
            if(flashcards.isEmpty()){
                Toast.makeText(this, "Najpierw dodaj fiszki", Toast.LENGTH_SHORT).show();
                return;
            }

            sekcjakreatora.setVisibility(View.GONE);
            sekcjaQuizzu.setVisibility(View.VISIBLE);

            dostepneFlashcardy = new ArrayList<>(flashcards);
            nastepnePytanie();
        });

        zakoczQuizz.setOnClickListener(v -> {
            sekcjakreatora.setVisibility(View.VISIBLE);
            sekcjaQuizzu.setVisibility(View.GONE);
        });

        btnCheckAns.setOnClickListener(v -> {
            if(currentFlashcard == null) return;

            String wpisanie = odpowiedz.getText().toString();
            String poprawne = currentFlashcard.getAnswer();

            boolean czyPoprawne = wpisanie.equalsIgnoreCase(poprawne);

            if(czyPoprawne == true){
                Toast.makeText(this, "Poprawna odpowiedz", Toast.LENGTH_SHORT).show();
            } else{
                Toast.makeText(this,"Zla odpowiedz", Toast.LENGTH_SHORT).show();
            }
            nastepnePytanie();
        });

        buttonAdd.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v){
                String pytanie = editTextPytanie.getText().toString();
                String odpowiedz = editTextOdpowiedz.getText().toString();

                if(pytanie.isEmpty() || odpowiedz.isEmpty()){
                    Toast.makeText(
                            MainActivity.this,
                            "Uzupelnij wszystkie pola",
                            Toast.LENGTH_SHORT
                    ).show();
                    return;
                }

                fiszki flashcard = new fiszki(pytanie, odpowiedz);

                flashcards.add(flashcard);
                adapter.notifyDataSetChanged();

                zacznijQuizz.setEnabled(true);

                editTextPytanie.setText("");
                editTextOdpowiedz.setText("");
            }
        });
    }

    private void nastepnePytanie(){
        if(dostepneFlashcardy == null || dostepneFlashcardy.isEmpty()){
            Toast.makeText(this,"Koniec fiszki", Toast.LENGTH_SHORT).show();
            sekcjaQuizzu.setVisibility(View.GONE);
            sekcjakreatora.setVisibility(View.VISIBLE);
            return;
        }

        Random generujPytanie = new Random();
        int losowyInt = generujPytanie.nextInt(dostepneFlashcardy.size());
        currentFlashcard = dostepneFlashcardy.get(losowyInt);
        pytanie.setText("Pytanie: " + currentFlashcard.getQuestion() + "?");
        odpowiedz.setText("");
        dostepneFlashcardy.remove(losowyInt);
    }
}


